# Copy to .env and adjust values as needed.
# Compose uses these variables with defaults, so a .env file is optional.

# Default expects the frontend folder to be at ./Korp-Frontend-Gabriel relative to this repository
FRONTEND_CONTEXT=./Korp-Frontend-Gabriel

# PostgreSQL credentials (used by db, estoque and faturamento)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# JWT signing (shared between estoque and faturamento; change in production)
JWT_KEY=korp-dev-secret-chave-segura-para-assinatura-jwt-2026
JWT_ISSUER=Korp
JWT_AUDIENCE=Korp-Angular

# Demo login credentials issued by the Estoque /api/auth/login endpoint
AUTH_USERNAME=gabriel
AUTH_PASSWORD=senha123
